@startuml
skinparam defaultFontName "Microsoft YaHei"
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
title 领域模型与数据访问类图
package "core.model" {
class User {
- id : long
- username : String
- role : Role
+ isAdmin() : boolean
}
class Item {
- ownerId, categoryId : long
- title : String
- price : BigDecimal
+ isOwnedBy(long) : boolean
}
class Category {
- id : long
- name : String
- parentId : Long
}
class Favorite {
- userId, itemId : long
- createdAt : LocalDateTime
}
class Deal {
- itemId, buyerId, sellerId : long
- status : DealStatus
- completedAt : LocalDateTime
}
class CarbonFactor {
- categoryId : long
- kgCo2SavedPerItem : double
}
class OperationLog {
- userId : long
- action, detail : String
}
class Review {
- dealId, reviewerId, revieweeId : long
- rating : int
}
class StatsReport {
- totalUsers, totalItems : int
- carbonSavedKg : double
- itemsByCategory : Map
}
User "1" -- "0..*" Item : 发布
Category "1" -- "0..*" Item : 分类
User "1" -- "0..*" Favorite
Item "1" -- "0..*" Favorite
Item "1" -- "0..*" Deal
User "1" -- "0..*" Deal : 买家/卖家
Deal "1" -- "0..2" Review : 成交互评
User "1" -- "0..*" Review : 评价双方
Category "1" -- "0..1" CarbonFactor
User "1" -- "0..*" OperationLog
}
package "数据访问与装配" {
 interface UserRepository {
  + findById(long) : Optional<User>
  + insert(User) : long
 }
 abstract class "AbstractJdbcDao<T>" as JdbcTemplate {
  # mapRow(ResultSet) : T
  # queryList(String, Object...)
 }
 class DatabaseManager {
  + openConnection() : Connection
  + inTransaction(SqlWork) : T
 }
 class UserRepositoryImpl
 class DaoFactory
 class ServiceFactory
 class Bootstrap
 UserRepository <|.. UserRepositoryImpl
 JdbcTemplate <|-- UserRepositoryImpl
 JdbcTemplate ..> DatabaseManager
 DaoFactory ..> DatabaseManager
 DaoFactory ..> UserRepositoryImpl : 创建
 ServiceFactory ..> UserRepository : 接收接口
 Bootstrap ..> DatabaseManager : 初始化
 Bootstrap ..> DaoFactory : 创建
 Bootstrap ..> ServiceFactory : 创建/注入
}
note bottom of StatsReport : 汇总对象，不单独建表
@enduml
