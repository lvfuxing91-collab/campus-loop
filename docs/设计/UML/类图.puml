@startuml 类图
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam defaultFontName "Microsoft YaHei"
skinparam classFontSize 11
skinparam nodesep 12
skinparam ranksep 30
hide empty members
hide circle
title 低碳校园资源循环流转系统 —— 类图（迭代 1）

package "core.model" as model {
  class User {
    - id : long
    - username : String
    - passwordHash : String
    - salt : String
    - nickname : String
    - role : Role
    - creditScore : double
    - enabled : boolean
    + isAdmin() : boolean
  }
  class Item {
    - id : long
    - ownerId : long
    - categoryId : long
    - title : String
    - tradeType : TradeType
    - price : BigDecimal
    - status : ItemStatus
    - viewCount : int
  }
  class Category {
    - id : long
    - name : String
    - sortOrder : int
    - enabled : boolean
  }
  class Deal {
    - id : long
    - itemId : long
    - buyerId : long
    - sellerId : long
    - status : DealStatus
  }
  class Review {
    - dealId : long
    - reviewerId : long
    - revieweeId : long
    - rating : int
  }
  class Favorite
  class OperationLog
  class CarbonFactor
  class StatsReport
}

package "core.repository" as repo {
  interface UserRepository
  interface ItemRepository
  interface CategoryRepository
  interface FavoriteRepository
  interface DealRepository
  interface ReviewRepository
  interface OperationLogRepository
  interface CarbonFactorRepository
}

package "core.service" as svc {
  interface AuthService
  interface ItemService
  interface DealService
  interface ReviewService
  interface StatsService
  interface AdminService
}

package "core.query" as query {
  class ItemQuery {
    - keyword : String
    - categoryId : Long
    - sort : ItemSortType
    + {static} builder() : ItemQueryBuilder
  }
}

package "core.util" as util {
  class PasswordUtil
  class Validators
  class CsvUtil
}

package "dao" as dao {
  class DatabaseManager
  abstract class AbstractJdbcDao
  class UserRepositoryImpl
  class ItemRepositoryImpl
  class CategoryRepositoryImpl
  class FavoriteRepositoryImpl
  class DealRepositoryImpl <<迭代2>>
  class ReviewRepositoryImpl <<迭代2>>
  class OperationLogRepositoryImpl
  class CarbonFactorRepositoryImpl
  class DaoFactory
}

package "service.impl" as svcimpl {
  class AuthServiceImpl
  class ItemServiceImpl
  class StatsServiceImpl
  class AdminServiceImpl
  class DealServiceImpl <<迭代2>>
  class ServiceFactory
}

package "ui" as ui {
  class LoginFrame
  class MainFrame
  class UiContext
  class BrowsePanel
  class MyItemsPanel
  class FavoritesPanel
  class StatsPanel
  class AdminPanel
  class ItemTableModel
}

package "app" as app {
  class Bootstrap
  class Main
}

' ---------- 实体关系 ----------
User "1" -- "0..*" Item : 发布
Category "1" -- "0..*" Item : 归类
User "1" -- "0..*" Favorite
Item "1" -- "0..*" Favorite
Item "1" -- "0..*" Deal
User "1" -- "0..*" Deal : 买家 / 卖家
Deal "1" -- "0..2" Review
Category "1" -- "0..1" CarbonFactor

' ---------- 仓储：实现关系 ----------
AbstractJdbcDao <|-- UserRepositoryImpl
AbstractJdbcDao <|-- ItemRepositoryImpl
AbstractJdbcDao <|-- CategoryRepositoryImpl
AbstractJdbcDao <|-- FavoriteRepositoryImpl
AbstractJdbcDao <|-- DealRepositoryImpl
AbstractJdbcDao <|-- ReviewRepositoryImpl
AbstractJdbcDao <|-- OperationLogRepositoryImpl
AbstractJdbcDao <|-- CarbonFactorRepositoryImpl

UserRepository <|.. UserRepositoryImpl
ItemRepository <|.. ItemRepositoryImpl
CategoryRepository <|.. CategoryRepositoryImpl
FavoriteRepository <|.. FavoriteRepositoryImpl
DealRepository <|.. DealRepositoryImpl
ReviewRepository <|.. ReviewRepositoryImpl
OperationLogRepository <|.. OperationLogRepositoryImpl
CarbonFactorRepository <|.. CarbonFactorRepositoryImpl

DaoFactory ..> DatabaseManager
DaoFactory ..> UserRepositoryImpl

' ---------- 服务：实现与依赖 ----------
AuthService <|.. AuthServiceImpl
ItemService <|.. ItemServiceImpl
StatsService <|.. StatsServiceImpl
AdminService <|.. AdminServiceImpl
DealService <|.. DealServiceImpl

AuthServiceImpl ..> UserRepository
AuthServiceImpl ..> PasswordUtil
ItemServiceImpl ..> ItemRepository
ItemServiceImpl ..> FavoriteRepository
StatsServiceImpl ..> ItemRepository
AdminServiceImpl ..> UserRepository
ServiceFactory ..> DaoFactory

' ---------- 界面 ----------
LoginFrame ..> UiContext
MainFrame ..> UiContext
MainFrame *-- BrowsePanel
BrowsePanel *-- ItemTableModel
UiContext ..> AuthService
UiContext ..> ItemService

' ---------- 组合根 ----------
Main ..> Bootstrap
Bootstrap ..> DatabaseManager
Bootstrap ..> DaoFactory
Bootstrap ..> ServiceFactory
Bootstrap ..> LoginFrame

note bottom of DatabaseManager : 单例：全局唯一数据库入口
note bottom of AbstractJdbcDao : 模板方法：JDBC 样板代码只写一次
note bottom of ItemQuery : 建造者：可选检索条件组合
note right of DealServiceImpl : 标 <<迭代2>> 的类\n本轮只有接口，实现留待下一轮

@enduml
